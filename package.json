{
	"name": "cloud-tui",
	"version": "0.1.2",
	"description": "A local-first terminal coding agent with durable sessions, worktree coordination, and approval-aware tools.",
	"license": "MIT",
	"bin": {
		"cloud-tui": "./release/cli.mjs"
	},
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amSinghTarun/cloud-tui.git"
	},
	"bugs": {
		"url": "https://github.com/amSinghTarun/cloud-tui/issues"
	},
	"homepage": "https://github.com/amSinghTarun/cloud-tui#readme",
	"keywords": [
		"ai",
		"agent",
		"cli",
		"coding-agent",
		"terminal",
		"tui"
	],
	"scripts": {
		"build": "bun build frontend/cli.tsx --target=node --format=esm --packages=external --outfile=release/cli.mjs --banner='#!/usr/bin/env node'",
		"dev": "bun --watch frontend/cli.tsx",
		"start": "node release/cli.mjs",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"prepack": "bun run typecheck && bun run build",
		"prepublishOnly": "bun test"
	},
	"files": [
		"release"
	],
	"dependencies": {
		"@google/genai": "^2.18.0",
		"dotenv": "^17.4.2",
		"ink": "^4.1.0",
		"meow": "^11.0.0",
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.0.0",
		"@types/react": "^18.0.32",
		"@vdemedes/prettier-config": "^2.0.1",
		"chalk": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"typescript": "^5.0.3",
		"xo": "^0.53.1"
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"import/extensions": "off",
			"react/prop-types": "off",
			"unicorn/expiring-todo-comments": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
